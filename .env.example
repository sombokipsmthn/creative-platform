# Database
DATABASE_URL=postgresql://kipsmthn:[REDACTED]@localhost:5432/kipsmthn
# Use PgBouncer connection pooling in production
# DATABASE_URL=postgresql://kipsmthn:[REDACTED]@pgbouncer:6432/kipsmthn?sslmode=disable
POSTGRES_PASSWORD=your_secure_password_here

# Metrics monitoring
ADMIN_METRICS_KEY=your_admin_metrics_key_here

# Better Auth
BETTER_AUTH_URL=http://localhost:3005
BETTER_AUTH_SECRET=

# OAuth callback URLs
# Local: http://localhost:3005/api/auth/callback/google
# Production: https://your-domain.example/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Passkeys / WebAuthn
# Use the exact public origin for each environment. Production requires HTTPS.
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Email delivery via Resend
RESEND_API_KEY=
EMAIL_FROM="Creative Platform <noreply@example.com>"
# Set this to your project-specific Sentinel identify ingestion URL.
NEXT_PUBLIC_BETTER_AUTH_IDENTIFY_URL=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
ADMIN_EMAIL=

BLOB_READ_WRITE_TOKEN=

# Production R2 storage
# Set STORAGE_PROVIDER=r2 when you are ready to migrate storage.
R2_ACCOUNT_ID=
R2_BUCKET=
CLOUDFLARE_API_TOKEN=
# Optional public R2 custom-domain base URL. Leave empty to keep objects private
# and serve them through /api/public/galleries/media.
R2_PUBLIC_URL=

# Gallery download tracking
DOWNLOAD_TRACKING_SALT=

# Vercel
# BLOB_READ_WRITE_TOKEN=

# CLI SESSION
PLAYWRIGHT_CLI_SESSION=

# Created by Vercel CLI
VERCEL_OIDC_TOKEN=
