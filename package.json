{
  "name": "creative-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3005 -H 0.0.0.0",
    "build": "next build --turbopack",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "audit:production": "env -u npm_config_allow_scripts npm audit --omit=dev --audit-level=high",
    "audit:development": "env -u npm_config_allow_scripts npm audit --audit-level=high || true",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:equipment": "tsx src/db/seed-equipment.ts",
    "db:seed:templates": "tsx src/db/seed-templates.ts",
    "healthcheck": "node scripts/healthcheck.mjs",
    "auth:check": "npm exec --yes auth@latest -- check --config ./src/lib/auth/auth.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/infra": "^0.4.15",
    "@better-auth/passkey": "^1.7.7",
    "@libsql/client": "^0.18.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/ffmpeg-static": "^3.0.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.7",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.42.0",
    "next": "^16.4.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^6.0.3",
    "resend": "^6.32.1",
    "sharp": "^0.35.5",
    "svix": "^2.3.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
