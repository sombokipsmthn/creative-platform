{
  "name": "creative-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build --turbopack",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "test:responsive-admin": "node scripts/responsive-admin-smoke.mjs",
    "test:authenticated-settings": "node scripts/authenticated-settings-smoke.mjs",
    "test:gallery-watermark": "node scripts/gallery-watermark-smoke.mjs",
    "audit:production": "env -u npm_config_allow_scripts npm audit --omit=dev --audit-level=high",
    "audit:development": "env -u npm_config_allow_scripts npm audit --audit-level=high || true",
    "db:generate": "drizzle-kit generate",
    "db:reconcile": "tsx scripts/reconcile-drizzle-migrations.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "npm run db:reconcile && npm run db:migrate",
    "db:seed:equipment": "tsx src/db/seed-equipment.ts",
    "db:seed:templates": "tsx src/db/seed-templates.ts",
    "healthcheck": "node scripts/healthcheck.mjs",
    "auth:check": "npm exec --yes auth@latest -- check --config ./src/lib/auth/auth.ts",
    "design-system:check": "node scripts/check-design-system.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@better-auth/infra": "^0.4.22",
    "@better-auth/passkey": "^1.7.10",
    "@libsql/client": "^0.18.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.104.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.32.0",
    "@types/ffmpeg-static": "^5.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vinext/cloudflare": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.54.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "playwright": "^1.64.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "read-excel-file": "^6.0.3",
    "resend": "^6.34.1",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "svix": "^2.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "11.1.1",
    "vinext": "^1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "axe-core": "^4.14.0",
    "cf": "^1.0.0-beta.20",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
